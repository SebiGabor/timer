# Opțional: doar pentru testare locală (.env.local).
# Nu urca niciodată .env.local sau token-uri Turso într-un repository public GitHub!
# În producție (GitHub Pages), configurează aceste date direct în Setările aplicației de pe telefon/laptop.
VITE_TURSO_DATABASE_URL=libsql://nume-db-utilizator.turso.io
VITE_TURSO_AUTH_TOKEN=token-ul-tau-turso
